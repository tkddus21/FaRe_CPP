# Python bytecode
__pycache__/
*.py[cod]

# Planner output, regenerated by every Surveillance.py run.
# Copy a run you want to keep into experiments/ instead.
FaRe/results/

# crop_map_to_house.py keeps the pre-crop map beside the cropped one so a re-run
# starts from what gmapping recorded rather than from its own output. Regenerable.
*.orig

# C++ build output (FaRe_CPP/output/ is deliberately tracked — sample run kept in-repo).
# bin/ is where CMakeLists.txt pins RUNTIME_OUTPUT_DIRECTORY, so it lands in the
# source tree rather than beside the cache in build/.
FaRe_CPP/build/
FaRe_CPP/bin/

# macOS
.DS_Store
